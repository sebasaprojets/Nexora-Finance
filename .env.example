# Copie para .env.local e preencha. Nunca faça commit de chaves secretas.
# No site publicado, estes valores vêm das Variables do GitHub (ver docs/LANCAMENTO.md).

# --- Nuvem (Supabase). Sem estas duas, a Nexora roda em modo local (dados só no navegador).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Login social (configure antes em Supabase → Authentication → Providers): on | (vazio)
VITE_AUTH_GOOGLE=
VITE_AUTH_APPLE=

# --- Planos e cobrança
# Limites do plano Grátis (contas, cartões, metas, IA…): ligados por padrão. "off" libera tudo.
VITE_PLAN_LIMITS=
# "on" ativa os limites do plano Grátis e o botão de assinar (exige as Edge Functions publicadas).
VITE_BILLING=
# "off" esconde a oferta do beta de fundadores na página inicial.
VITE_FOUNDER_OFFER=
# Preços exibidos (os cobrados ficam nos secrets do Supabase — mantenha iguais).
VITE_PRICE_PRO_MONTHLY=14.90
VITE_PRICE_PRO_YEARLY=119
VITE_PRICE_FOUNDER_MONTHLY=9.90

# --- Dados do negócio (rodapé, termos e suporte)
VITE_COMPANY_NAME=
VITE_COMPANY_CNPJ=
VITE_COMPANY_CITY=
VITE_SUPPORT_EMAIL=
# Só números com DDI+DDD, ex.: 5511999998888
VITE_SUPPORT_WHATSAPP=

# Chave pública VAPID para Web Push (a privada fica SOMENTE no servidor).
VITE_VAPID_PUBLIC_KEY=
